# ── 必須 ──────────────────────────────────────────────────────────────
# MySQL接続文字列（RailwayのMySQLプラグインなら ${MySQL.MYSQL_URL} を参照）
# TLSはアプリ側で自動有効（localhost以外）。?ssl={...} のクエリは不要
DATABASE_URL=mysql://user:pass@host:3306/threads_studio
# TLSを切る/証明書検証だけ切る場合: DB_SSL=off / DB_SSL=insecure

# セッションJWTの署名鍵。`openssl rand -hex 32` で生成
JWT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials で
# 「OAuthクライアントID（ウェブアプリケーション）」を作成し、
# 承認済みリダイレクトURIに https://<あなたのドメイン>/api/oauth/callback を登録
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 公開URL（例: https://your-app.up.railway.app）。未設定ならリクエストから導出
APP_URL=

# ── アクセス制御 ──────────────────────────────────────────────────────
# ログインを許可するGoogleアカウントのメール（カンマ区切り）。
# 未設定の場合は「最初にログインした人」だけが受け入れられ、管理者になる。
ALLOWED_EMAILS=

# ── Threads連携（クライアントが自分で連携する場合） ──────────────────
# Meta for Developers のアプリID と、Threads API 設定の App Secret
# 併せて、Metaの「Redirect Callback URLs」に次を登録すること:
#   https://<あなたのドメイン>/api/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── AIアシスト（任意） ────────────────────────────────────────────────
# OpenAI APIキー。サーバー側でのみ使用し、画面やログには一切出さない
OPENAI_API_KEY=
# 使用するOpenAIモデル。省略時は gpt-5.6-terra
OPENAI_MODEL=

# ── 成果Webhook（任意） ──────────────────────────────────────────────
# HMAC-SHA256署名鍵。十分に長いランダム値を設定し、送信側とだけ共有する
CONVERSION_WEBHOOK_SECRET=

# ── 通知メール（任意・Resend） ────────────────────────────────────────
# 未設定の場合、トークン失効・投稿エラー等の通知はサーバーログのみ
RESEND_API_KEY=
NOTIFY_EMAIL=
# EMAIL_FROM="Threads Studio <notify@yourdomain.com>"

# ── 外部cron（任意） ──────────────────────────────────────────────────
# 内蔵スケジューラ（15分ごと）が既定で動くため通常は不要。
# 外部cronから POST /api/scheduled/tick を叩く場合のみ設定
# CRON_SECRET=
# 内蔵スケジューラを止めたい場合: DISABLE_SCHEDULER=1
